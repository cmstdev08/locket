[Script]
revenuecat = type=http-response, pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts$|subscribers\/[^/]+$), script-path=https://raw.githubusercontent.com/cmstdev08/locket/master/locket60s/anhtuaan08-admin-expiry-check.js, requires-body=true, max-size=-1, timeout=60
deleteHeader = type=http-request, pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts|subscribers), script-path=https://raw.githubusercontent.com/cmstdev08/locket/master/locket60s/deleteHeader-expiry-check.js, timeout=60
locket_rc = type=http-response, pattern=^https:\/\/firebaseremoteconfig\.googleapis\.com\/v1\/projects\/locket-4252a\/.+, script-path=https://raw.githubusercontent.com/cmstdev08/locket/master/locket60s/anhtuaan08-admin-expiry-check.js, requires-body=true, max-size=-1, timeout=60
locket_profile_badge = type=http-response, pattern=^https:\/\/(api\.locketcamera\.com|us-central1-locket-4252a\.cloudfunctions\.net)\/(?:[^?#]*\/)?(fetchUserV2|getUserByUsername|changeProfileInfo|updateUser|createUser)(?:[/?#]|$), script-path=https://raw.githubusercontent.com/cmstdev08/locket/master/locket60s/anhtuaan08-admin-expiry-check.js, requires-body=true, max-size=-1, timeout=30
locket_caption_post16 = type=http-request, pattern=^https:\/\/(api\.locketcamera\.com|us-central1-locket-4252a\.cloudfunctions\.net)\/(?:postMomentV2|postMoment)(?:\?.*)?$, script-path=https://raw.githubusercontent.com/cmstdev08/locket/master/locket60s/caption-admin.js, requires-body=true, max-size=-1, timeout=60

[MITM]
hostname = %APPEND% api.revenuecat.com, firebaseremoteconfig.googleapis.com, api.locketcamera.com, us-central1-locket-4252a.cloudfunctions.net
